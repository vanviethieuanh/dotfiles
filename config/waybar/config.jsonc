{
    "layer": "top",
    "margin-left": 12,
    "margin-right": 8,
    "margin-top": 12,
    "modules-left": [
        "cpu",
        "custom/separator",
        "memory",
        "custom/separator",
        "network",
        "custom/separator",
        "custom/nordvpn"
    ],
    "modules-center": [
        "hyprland/workspaces"
    ],
    "modules-right": [
        "custom/brightness",
        "custom/separator",
        "pulseaudio",
        "custom/separator",
        "clock",
        "custom/separator",
        "custom/lunis",
        "custom/separator",
        "custom/notification"
    ],
    "sway/window": {
        "max-length": 50
    },
    "clock": {
        "format": "{:%H %M}",
        "format-alt": "{:%A, %d %B %Y - %H:%M}",
        "tooltip": false
    },
    "network": {
        "interface": "enp5s0",
        "format": "{ifname} {bandwidthUpOctets}",
        "format-wifi": "<span font='Symbols Nerd Font Mono, 16px'>{essid} ({signalStrength}%) </span>",
        "format-ethernet": "<span font='Symbols Nerd Font Mono, 16px'>󰈀</span> <span font='Symbols Nerd Font Mono, 12px'></span> {bandwidthUpBytes} <span font='Symbols Nerd Font Mono, 12px'></span> {bandwidthDownBytes}",
        "format-disconnected": "",
        "tooltip-format": "<span font='Symbols Nerd Font Mono, 16px'>{ifnam} via {gwaddr} 󰊗</span>",
        "tooltip-format-wifi": "<span font='Symbols Nerd Font Mono, 16px'>{essid} ({signalStrength}%) </span>",
        "tooltip-format-ethernet": "<span font='Symbols Nerd Font Mono, 16px'>{ifname} </span>",
        "tooltip-format-disconnected": "Disconnected",
        "max-length": 50
    },
    "pulseaudio": {
        "format": "<span font='Symbols Nerd Font Mono, 16px'> </span> {volume}%",
        "format-bluetooth": "<span font='Symbols Nerd Font Mono, 16px'> </span> {volume}%",
        "format-muted": "<span font='Symbols Nerd Font Mono, 16px'></span>",
        "format-icons": {
            "default": [
                "<span font='Symbols Nerd Font Mono, 16px'></span>",
                "<span font='Symbols Nerd Font Mono, 16px'></span>"
            ]
        },
        "scroll-step": 1,
        "on-click": "pavucontrol"
    },
    "hyprland/workspaces": {
        "all-outputs": true,
        "format": "{icon}",
        "format-icons": {
            "1": "甲",
            "2": "乙",
            "3": "丙",
            "4": "丁",
            "5": "戊",
            "6": "己",
            "7": "庚",
            "8": "辛",
            "9": "壬",
            "10": "癸",
            "default": "平"
        },
        "persistent-workspaces": {
            "*": 5
        }
    },
    "custom/nordvpn": {
        "exec": "~/.config/scripts/nordvpn-status.sh",
        "interval": 1
    },
    "memory": {
        "interval": 3,
        "format": "<span font='Symbols Nerd Font Mono, 18px'></span>  {used:0.1f}G/{total:0.1f}G",
        "max-length": 20
    },
    "cpu": {
        "interval": 3,
        "format": "<span font='Symbols Nerd Font Mono, 16px'></span> {}%",
        "max-length": 10
    },
    "custom/lunis": {
        "tooltip": true,
        "return-type": "json",
        "exec": "/home/accodius/.cargo/bin/lunis judge --born '2001-11-17T03:15:00+07:00' -o waybar -l vi -f '{y-s} {y-b} ({y-y},{y-w})'",
        "interval": 60
    },
    "custom/powermenu": {
        "tooltip": false,
        "format": "<span font='Symbols Nerd Font Mono, 16px'></span>",
        "on-click": "~/.config/rofi/scripts/powermenu.sh"
    },
    "custom/brightness": {
        "interval": 1,
        "return-type": "json",
        "exec": "~/.config/scripts/fetch_sunset.sh",
        "format": "<span font='Symbols Nerd Font Mono, 16px'></span> {text}",
        "on-scroll-up": "hyprctl hyprsunset gamma +1",
        "on-scroll-down": "hyprctl hyprsunset gamma -1"
    },
    "custom/separator": {
        "format": "|",
        "interval": "once",
        "tooltip": false
    },
    "custom/notification": {
        "format": "<span font='Symbols Nerd Font Mono, 16px'>󰚅</span>",
        "interval": "once",
        "tooltip": false,
        "on-click": "swaync-client -op"
    }
}
