;; `` are just regular quotes
(defpoll time :interval "60s"
  `/home/accodius/.cargo/bin/lunis now -l zh -f "{y-s}{y-b}年 {m-S} {d-s}{d-b}日"`)

(defwidget lunis_calligraphy []
  (label
    :class "calligraphy"
    :text time))

(defwindow lunis
  :monitor 0
  :wm-ignore true
  :geometry (geometry
    :x "30%"
    :y "75%"
    :width "35%"
    :height "30%")
  :stacking "bg"
  :exclusive false
  :focusable "none"
  :namespace "eww"
  (lunis_calligraphy))

