{
    "$schema": "https://lnav.org/schemas/config-v1.schema.json",
    "ui": {
        "theme": "everforest",
        "theme-defs": {
            "everforest": {
                "vars": {
                    "background": "#2f383e",
                    "foreground": "#d3c6aa",
                    "red": "#e67e80",
                    "orange": "#e69875",
                    "yellow": "#dbbc7f",
                    "green": "#a7c080",
                    "aqua": "#83c092",
                    "blue": "#7fbbb3",
                    "cyan": "#83c092",
                    "purple": "#d699b6",
                    "magenta": "#d699b6",
                    "comment": "#859289",
                    "selection": "#3d484d",
                    "bgdarker": "#222c30",
                    "bglight": "#374247"
                },
                "styles": {
                    "text": { "color": "$foreground", "background-color": "$background" },
                    "selected-text": { "background-color": "$selection" },
                    "identifier": { "color": "$aqua" },
                    "alt-text": { "background-color": "$bgdarker" },
                    "ok": { "color": "$green" },
                    "info": { "color": "$aqua" },
                    "warning": { "color": "$yellow" },
                    "error": { "color": "$red" },
                    "hidden": { "color": "$comment" },
                    "cursor-line": { "color": "$foreground", "background-color": "$selection" },
                    "disabled-cursor-line": { "color": "$foreground", "background-color": "$bgdarker" },
                    "adjusted-time": { "color": "$magenta" },
                    "skewed-time": { "color": "$yellow" },
                    "offset-time": { "color": "$cyan" },
                    "time-column": { "background-color": "$bglight" },
                    "time-ago": { "bold": true },
                    "file-offset": { "color": "$comment" },
                    "invalid-msg": { "color": "$yellow" },
                    "focused": { "color": "$background", "background-color": "$green" },
                    "disabled-focused": { "color": "$foreground", "background-color": "$comment" },
                    "popup": { "color": "$foreground", "background-color": "$bgdarker" },
                    "popup-border": { "color": "$comment", "background-color": "$bgdarker" },
                    "scrollbar": { "color": "$background", "background-color": "$foreground" },
                    "timeline-bar": { "background-color": "$aqua" },
                    "h1": { "color": "$purple", "bold": true },
                    "h2": { "color": "$purple", "underline": true },
                    "h3": { "color": "$purple" },
                    "h4": { "underline": true },
                    "h5": { "italic": true },
                    "h6": { "italic": true },
                    "hr": { "color": "$comment" },
                    "hyperlink": { "color": "$blue", "underline": true },
                    "list-glyph": { "color": "$aqua" },
                    "breadcrumb": { "color": "$blue", "bold": true },
                    "table-border": { "color": "$comment" },
                    "table-header": { "bold": true },
                    "quote-border": { "color": "$comment", "background-color": "$bgdarker" },
                    "quoted-text": { "color": "$yellow", "background-color": "$bgdarker" },
                    "footnote-border": { "color": "$blue", "background-color": "$bgdarker" },
                    "footnote-text": { "color": "$cyan", "background-color": "$bgdarker" },
                    "snippet-border": { "color": "$cyan" },
                    "indent-guide": { "color": "$bglight" }
                },
                "syntax-styles": {
                    "inline-code": { "color": "$green", "background-color": "$bgdarker" },
                    "quoted-code": { "color": "$orange", "background-color": "$bgdarker" },
                    "code-border": { "color": "$comment", "background-color": "$bgdarker" },
                    "object-key": { "color": "$aqua" },
                    "keyword": { "color": "$purple", "bold": true },
                    "string": { "color": "$yellow" },
                    "comment": { "color": "$comment" },
                    "doc-directive": { "color": "$purple" },
                    "variable": { "color": "$orange" },
                    "symbol": { "color": "$cyan" },
                    "re-special": { "color": "$cyan" },
                    "re-repeat": { "color": "$yellow" },
                    "diff-delete": { "color": "$red" },
                    "diff-add": { "color": "$green" },
                    "diff-section": { "color": "$blue" },
                    "spectrogram-low": { "color": "$background", "background-color": "$green", "bold": true },
                    "spectrogram-medium": { "color": "$background", "background-color": "$yellow", "bold": true },
                    "spectrogram-high": { "color": "$background", "background-color": "$red", "bold": true },
                    "file": { "color": "$blue" },
                    "null": { "color": "$comment" },
                    "ascii-control": { "color": "$green" },
                    "non-ascii": { "color": "$yellow" },
                    "number": { "color": "$orange" },
                    "function": { "color": "$green" },
                    "separators-references-accessors": { "color": "$purple" },
                    "type": { "color": "$cyan" }
                },
                "status-styles": {
                    "disabled-title": { "color": "$blue", "background-color": "$bglight", "bold": true },
                    "title": { "color": "$background", "background-color": "$green", "bold": true },
                    "alert-title": { "color": "$red", "background-color": "$bglight", "bold": true },
                    "subtitle": { "color": "$background", "background-color": "$aqua", "bold": true },
                    "info": { "color": "$comment", "background-color": "$bglight" },
                    "title-hotkey": { "color": "$background", "background-color": "$green", "underline": true },
                    "hotkey": { "color": "$foreground", "underline": true },
                    "text": { "color": "$foreground", "background-color": "$bglight" },
                    "warn": { "color": "$orange", "background-color": "$bglight" },
                    "alert": { "color": "$red", "background-color": "$bglight" },
                    "active": { "color": "$green", "background-color": "$bglight" },
                    "inactive": { "color": "$comment", "background-color": "$bgdarker" },
                    "inactive-warn": { "color": "$orange", "background-color": "$bgdarker" },
                    "inactive-alert": { "color": "$red", "background-color": "$bgdarker" },
                    "suggestion": { "color": "$comment" }
                },
                "log-level-styles": {
                    "trace": { "color": "$comment" },
                    "debug": { "color": "$blue" },
                    "info": { "color": "$green" },
                    "stats": { "color": "$aqua" },
                    "notice": { "color": "$aqua" },
                    "warning": { "color": "$yellow" },
                    "error": { "color": "$red" },
                    "critical": { "color": "$red", "bold": true },
                    "fatal": { "color": "$red", "bold": true },
                    "invalid": { "color": "$orange" }
                }
            }
        }
    }
}
