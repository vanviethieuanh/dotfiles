{
    "layer": "top",
    "margin-left": 20,
    "margin-right": 20,
    "margin-top": 5,
    "modules-left": [
        "cpu",
        "memory",
        "network",
        "custom/nordvpn",
        "pulseaudio"
    ],
    "modules-center": [
        "hyprland/workspaces"
    ],
    "modules-right": [
        "clock"
    ],
    "sway/window": {
        "max-length": 50
    },
    "clock": {
        "format": "{:%H %M}",
        "format-alt": "{:%A, %d %B %Y - %H:%M}",
        "tooltip": false
    },
    "network": {
        "interface": "enp5s0",
        "format": "{ifname}",
        "format-wifi": "{essid} ({signalStrength}%) ",
        "format-ethernet": "󰈀",
        "format-disconnected": "",
        "tooltip-format": "{ifnam} via {gwaddr} 󰊗",
        "tooltip-format-wifi": "{essid} ({signalStrength}%) ",
        "tooltip-format-ethernet": "{ifname} ",
        "tooltip-format-disconnected": "Disconnected",
        "max-length": 50
    },
    "pulseaudio": {
        "format": "  {volume}%",
        "format-bluetooth": "  {volume}%",
        "format-muted": "",
        "format-icons": {
            "default": [
                "",
                ""
            ]
        },
        "scroll-step": 1,
        "on-click": "pavucontrol"
    },
    "hyprland/workspaces": {
        "all-outputs": true,
        "format": "{icon}",
        "format-icons": {
            "1": "一",
            "2": "二",
            "3": "三",
            "4": "四",
            "5": "五",
            "6": "六",
            "7": "七",
            "8": "八",
            "9": "九",
            "10": "十",
            "default": "平"
        },
        "persistent-workspaces": {
            "*": 5, // 5 workspaces by default on every monitor
            "HDMI-A-1": 3 // but only three on HDMI-A-1
        }
    },
    "custom/nordvpn": {
        "exec": "~/.config/waybar/scripts/nordvpn-status.sh",
        "interval": 1
    },
    "memory": {
        "interval": 3,
        "format": "  {used:0.1f}G/{total:0.1f}G",
        "max-length": 20
    },
    "cpu": {
        "interval": 3,
        "format": " {}%",
        "max-length": 10
    }
}
